# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://mxuvbjjunajthrtlxrbr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<get from Supabase dashboard → Settings → API>
SUPABASE_SERVICE_ROLE_KEY=<get from Supabase dashboard → Settings → API — server-side only, never expose to client>

# ─────────────────────────────────────────────
# App URL
# ─────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production (Vercel): https://imaniventures.org
NEXT_PUBLIC_APP_URL=https://imaniventures.org

# ─────────────────────────────────────────────
# Loops transactional email
# ─────────────────────────────────────────────
LOOPS_API_KEY=<get from loops.so → Settings → API keys>
# Admin inbox for new-application alerts — keep support@sda.ng until imaniventures.org mailbox is live
LOOPS_ADMIN_EMAIL=support@sda.ng

# Loops transactional template IDs — opaque IDs only, NOT friendly slugs.
# Find each ID: loops.so → Transactional → click template → Review → API Details → "transactionalId"
# Example: cmrfx8x3x04g50j1m8i1tvewv  (NOT "admin-invite")
LOOPS_TEMPLATE_APPLICATION_SUBMITTED=
LOOPS_TEMPLATE_APPLICATION_UNDER_REVIEW=
LOOPS_TEMPLATE_APPLICATION_APPROVED=
LOOPS_TEMPLATE_APPLICATION_REJECTED=
LOOPS_TEMPLATE_NEW_APPLICATION_ADMIN=
LOOPS_TEMPLATE_ADMIN_INVITE=
# Variables: applicant_name, business_name, documents_note
LOOPS_TEMPLATE_DOCUMENTS_REQUESTED=

# ─────────────────────────────────────────────
# Paystack — investor membership fee
# ─────────────────────────────────────────────
# Use TEST keys locally; set LIVE keys in Vercel production env vars only
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
